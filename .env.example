# Copy to `.env.local`. Every variable is optional — the page still builds
# and deploys without them. Features that need a key degrade to a honest
# fallback instead of crashing.

# ---------------------------------------------------------------------------
# Contact form — Resend  https://resend.com
# ---------------------------------------------------------------------------
# 1. Create an account and add the domain `jaychauhan.tech`.
# 2. Paste the SPF / DKIM / DMARC records Resend shows into your DNS.
# 3. Wait until the domain is Verified.
# 4. Create an API key with Sending access only.
# 5. Put the key here AND in the production host's env (Vercel → Settings).
#
# Default sender is `Portfolio <portfolio@jaychauhan.tech>`.
# Default inbox is `contact@jaychauhan.tech` — that address must actually
# receive mail (Google Workspace, Cloudflare Email Routing, etc.).
#
# Without RESEND_API_KEY the form stays on the page and tells the visitor
# to use the email on the left.
RESEND_API_KEY=

# Override only if the mailbox or the verified From needs to differ.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# LinkedIn feed (section 09)
# ---------------------------------------------------------------------------
# LinkedIn has no public read API for your own posts. Point this at a bridge
# that republishes the profile as a feed:
#
#   1. Open https://rss.app (or any RSS-from-URL bridge).
#   2. New feed from https://www.linkedin.com/in/jay-chauhan-5a65921ba/
#   3. Paste the generated RSS / Atom / JSON Feed URL here.
#
# Unset => the section shows its fallback line and still links the profile.
LINKEDIN_FEED_URL=

# ---------------------------------------------------------------------------
# Search Console / Bing Webmaster
# ---------------------------------------------------------------------------
# Paste the `content` value of the verification meta tag, not the whole tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
