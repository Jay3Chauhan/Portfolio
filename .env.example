# Google Search Console — HTML tag verification code (content value only, not the full meta tag)
# Get this from: Search Console → Settings → Ownership verification → HTML tag
GOOGLE_SITE_VERIFICATION=your_verification_code_here

# Web3Forms — powers the contact form (src/components/ContactForm.tsx)
# Free, no backend required. Get a key at https://web3forms.com (enter your
# email, no signup needed — the key arrives by email in seconds).
# Must be prefixed NEXT_PUBLIC_ since it's used client-side (this is safe;
# Web3Forms access keys are designed to be public, like a form endpoint ID).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
